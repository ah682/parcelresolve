# Default: offline only. The known demo tokens authenticate synthetic local data.
PARCELRESOLVE_MODE=simulator
PARCELRESOLVE_DATA_DIR=.parcelresolve
PARCELRESOLVE_OPERATOR_TOKEN=demo-operator
PARCELRESOLVE_VIEWER_TOKEN=demo-viewer
PARCELRESOLVE_INTAKE_MODE=deterministic
PARCELRESOLVE_ALLOW_MODEL_NETWORK=0
# Experimental local CPU model, evaluation-only. The frozen comparison did
# not demonstrate an improvement; the desk API refuses local-model intake.
# Explicit provisioning: python -m parcelresolve.local_model setup --download
# Enable only for the local_model probe or model_evaluation CLI.
PARCELRESOLVE_ENABLE_LOCAL_MODEL=0
PARCELRESOLVE_LOCAL_MODEL_DIR=.models/parcelresolve-local-ai
PARCELRESOLVE_LOCAL_MODEL_THREADS=4
PARCELRESOLVE_LOCAL_MODEL_SEED=7
# Optional explicit model use incurs provider charges. No model is selected by default.
OPENAI_API_KEY=
OPENAI_MODEL=
# Real adapters and the guarded-live CLI are separate from the simulator UI.
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
WOO_STORE_ID=store-1
WOO_ORDER_ID=
SHIPSTATION_V1_KEY=
SHIPSTATION_V1_SECRET=
SHIPSTATION_ORDER_ID=
SHIPSTATION_V2_KEY=
SHIPSTATION_LABEL_ID=
PARCELRESOLVE_CONTRACT_READS=0
# These approvals authorize review artifacts only: enabling this cannot enable
# unsupported execution, purchase labels, issue refunds or change orders.
PARCELRESOLVE_ALLOW_LIVE_MUTATIONS=0
PARCELRESOLVE_LIVE_REVIEW_DIR=.parcelresolve-live-review
PARCELRESOLVE_LIVE_OWNER_ID=
PARCELRESOLVE_LIVE_OPERATOR_ID=
# Use separate server-side role secrets with at least 32 characters; never use demo tokens.
PARCELRESOLVE_LIVE_OWNER_TOKEN=
PARCELRESOLVE_LIVE_OPERATOR_TOKEN=
# Set only in the invoking approval/dry-run/reconciliation process, never in arguments.
PARCELRESOLVE_REVIEW_SUBMITTED_TOKEN=
